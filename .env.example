# insurance-claim-mcp environment template.
# Copy to .env (never commit .env). Only the variables below are read by the server.

# Database URL. Leave unset to use local SQLite:
#   - source checkout: ./claim_service.db
#   - installed package (uvx / pip): ~/.insurance-claim-mcp/claim_service.db
# PostgreSQL example (Neon / Cloud SQL):
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=

# Version string reported by GET /api/version (set by the deploy pipeline).
# APP_VERSION=local
