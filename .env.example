# ==============================================================================
# Environment Configuration for Insurance Claim FastMCP Server
# ==============================================================================

# Application Environment: 'production', 'development', or 'test'
APP_ENV=development

# Database Connection URL:
# - SQLite (local file): sqlite:///./claim_service.db
# - PostgreSQL (Production/Neon/Cloud SQL): postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///./claim_service.db

# Master API Key for Server-to-Server Authentication
API_KEY=your-secure-master-api-key-here

# Public Base URL of this service (Used for CORS and MCP discovery)
PUBLIC_BASE_URL=http://localhost:8080

# Whether to auto-seed synthetic demo users on startup (Set to false in production)
SEED_SAMPLE_DATA=false

# Port & Host configuration
PORT=8080
HOST=0.0.0.0
